// --- Palette (ต่อเนื่องกับตารางโทน gold-dark) ---
bool  vDark   = chartTheme == "Dark"
color vBull   = color.rgb(0, 210, 160)      // Buy / TP / Win
color vBear   = color.rgb(255, 82, 82)      // Sell / SL / Loss
color vPlan   = color.rgb(212, 175, 55)     // Pending Pullback plan (gold = สิ่งที่ต้องทำ)
color vMid    = color.rgb(102, 208, 255)    // Pending Mid-Level plan (cyan)
