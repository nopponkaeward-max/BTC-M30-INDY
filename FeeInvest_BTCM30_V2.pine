showMon = input.bool(true,  title="Mon",      group="Display & Stats", inline="days1")
showTue = input.bool(true,  title="Tue",      group="Display & Stats", inline="days1")
showWed = input.bool(true,  title="Wed",      group="Display & Stats", inline="days2")
