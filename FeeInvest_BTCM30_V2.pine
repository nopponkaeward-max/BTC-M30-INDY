// --- Display & Stats ---
labelSizeOpt  = input.string("tiny", title="▶ ขนาดป้ายบนกราฟ (Chart Label Size)", options=["tiny", "small", "normal", "large", "huge"], group="Display & Stats", tooltip="ขนาดตัวอักษรของป้ายบนกราฟทั้งหมด: ป้ายรอเบรค, กำลังถือ, WIN/LOSS และป้ายราคา Entry/TP/SL")
wlBgColor    = input.color(color.yellow, title="▶ สีพื้นป้าย 'รอ Limit'", group="Display & Stats", tooltip="สีพื้นหลังของป้าย 'รอ BUY/SELL LIMIT ที่นี่' — ปรากฏหลังราคาเบรคขอบกรอบ")
wlTextColor  = input.color(color.black,  title="▶ สีตัวอักษรป้าย 'รอ Limit'", group="Display & Stats", tooltip="สีตัวอักษรของป้าย 'รอ BUY/SELL LIMIT ที่นี่'")
