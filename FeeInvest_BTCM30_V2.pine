//@version=6

indicator("FeeInvest_BTCM30", shorttitle="FeeInvest_BTCM30", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ==========================================
// --- 1. INPUT SETTINGS ---
// ==========================================

// --- Swing Pattern ---
dowSwingLen    = 3
showDowLabels  = false
showPatternBox = false
maxPatBoxes    = 300

// --- Entry Strategy (Pullback %) ---
pbFlowTip = "ทุก pattern เข้าแบบ Pullback%:\n\nกรอบ Bearish (Sell): รอราคาเบรค 'ขอบล่าง' ก่อน → ราคาย่อกลับขึ้น X% ของกรอบ → เปิด SELL\nกรอบ Bullish (Buy): รอราคาเบรค 'ขอบบน' ก่อน → ราคาย่อกลับลง X% ของกรอบ → เปิด BUY"
pullbackMode     = "% of Range"
pullbackRangePct = 25
pullbackPct      = 0.4
planExpireBars   = 100
breakEitherWay   = false

// --- Trade Days (งด/เทรดวันไหน — ดูวันที่แพ้บ่อยจากตาราง By-Day) ---
tradeDayTip = "เลือกวันที่อนุญาตให้เปิดออเดอร์ (อิงวันที่ pattern เกิด, timezone tz)\nติ๊กออก = งดเทรดวันนั้น (ข้ามการสร้าง plan)\nดูวันที่แพ้บ่อยได้จากตาราง By-Day"
tradeSun = false
tradeMon = false
tradeTue = true
tradeWed = true
tradeThu = true
tradeFri = true
tradeSat = false

// --- Mid-Level Entry (parallel — ทำงานร่วมกับ Pullback%) ---
midTip = "เข้าไม้กลางกรอบ ทำงานคู่ขนานกับ Pullback%\n\nวัดจาก 'ขอบฝั่ง momentum' เข้ามา X%:\nBull box: entry = ขอบบน − X%×range | เงื่อนไข close > entry → limit BUY\nBear box: entry = ขอบล่าง + X%×range | เงื่อนไข close < entry → limit SELL\n\nX เล็ก = เข้าใกล้ขอบ (ย่อตื้น) | X ใหญ่ = เข้าลึกกลางกรอบ"
useMidLevel  = true
midOnly      = false
midDualSide  = false
midEntryPct  = 25
// --- Mid SL ---
