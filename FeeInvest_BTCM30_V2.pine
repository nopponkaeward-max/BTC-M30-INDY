int enabledDayCnt = (showSun?1:0)+(showMon?1:0)+(showTue?1:0)+(showWed?1:0)+(showThu?1:0)+(showFri?1:0)+(showSat?1:0)

statMode    = input.string("2. ย้อนหลังตามจำนวนเดือน (Months)", title="▶ โหมดดูสถิติ", options=["1. ย้อนหลังตามจำนวนวัน (Days)", "2. ย้อนหลังตามจำนวนเดือน (Months)", "3. เจาะจงเดือนและปี (Specific Month)"], group="Display & Stats")
statDays    = input.int(1, title="[โหมด 1] ย้อนหลัง (วัน)", minval=1, maxval=365, group="Display & Stats")
statMonths  = input.int(8, title="[โหมด 2] ย้อนหลัง (เดือน)", minval=1, maxval=12, group="Display & Stats")
statTargetM = input.string("August", title="[โหมด 3] ระบุเดือน", options=["January","February","March","April","May","June","July","August","September","October","November","December"], group="Display & Stats")
statTargetY = input.int(0, title="[โหมด 3] ระบุปี (0 = ปีปัจจุบัน)", minval=0, maxval=2100, group="Display & Stats")

mainTablePosStr     = input.string("Bottom Right",  title="▶ ตำแหน่งตารางหลัก (Stats)",   options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Table Position")
dayTablePosStr      = input.string("Middle Right",  title="▶ ตำแหน่งตาราง By-Day",         options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Table Position")
monthlyTablePosStr  = input.string("Bottom Center", title="▶ ตำแหน่งตาราง Monthly",        options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Table Position")
dailyTablePosStr    = input.string("Middle Left",   title="▶ ตำแหน่งตาราง Daily Log",       options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Table Position")
settingsTablePosStr = "Bottom Left"

tz_incr      = 0
use_exchange = false

// ==========================================
// --- 2. TIMEZONE, HELPERS & STATE ---
// ==========================================

var tz = use_exchange ? syminfo.timezone : str.format("UTC{0}{1}", tz_incr >= 0 ? "+" : "-", math.abs(tz_incr))

f_tablePos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right

int currentYear   = year(timenow, tz)
int actualTargetY = statTargetY == 0 ? currentYear : statTargetY

oneRDistOf(float rng) => oneRBasis == "Distance" ? oneRDistFix : oneRBasis == "ATR" ? oneRAtr : rng * oneRPct

// คำนวณ oneR / SL / TP ของออเดอร์จาก entry — ใช้ทั้งตอน fill จริงและตอน preview บน plan
f_planLevels(bool _isB, int _ptype, float _ent, float _top, float _bot, float _rng) =>
    float _oneR = 0.0
    float _sl   = 0.0
    float _tp   = 0.0
    if _ptype == 1
        float _slp = midSlMode == "Box Edge" ? (_isB ? _bot : _top) : (_isB ? _ent - _rng * (midSlPct / 100) : _ent + _rng * (midSlPct / 100))
        _oneR := math.abs(_ent - _slp)
        _sl   := _slp
        float _tpEdge = _isB ? _top : _bot
        _tp := switch midTpMode
            "Box Edge"  => _tpEdge
            "R:R Ratio" => _isB ? _ent + _oneR * midRR : _ent - _oneR * midRR
            =>             _isB ? _ent + _rng * (midTpPct / 100) : _ent - _rng * (midTpPct / 100)
    else
        _oneR := oneRDistOf(_rng)
        _sl   := slEdgeMode ? (_isB ? _bot : _top) : (_isB ? _ent - _oneR : _ent + _oneR)
        _tp   := _isB ? _ent + (_oneR * rrRatio) : _ent - (_oneR * rrRatio)
    [_oneR, _sl, _tp]

// --- Result arrays (for stats) ---
var array<bool>  resIsWin   = array.new_bool()
var array<float> resTradeRR = array.new_float()
var array<int>   resTime    = array.new_int()
var array<bool>  resIsSmall = array.new_bool()
var array<bool>  resIsRec   = array.new_bool()
var array<float> resTpPts   = array.new_float()
var array<int>   dayList    = array.new_int()

int curDayId = (year(time, tz) * 10000) + (month(time, tz) * 100) + dayofmonth(time, tz)
bool needPushDay = array.size(dayList) == 0
if not needPushDay
    needPushDay := array.get(dayList, array.size(dayList) - 1) != curDayId
if needPushDay
    array.push(dayList, curDayId)
    if array.size(dayList) > 400
        array.shift(dayList)

// --- Drawing registries ---
var array<box>   patBoxReg = array.new<box>()
var array<line>  regLines  = array.new<line>()
var array<label> regLabels = array.new<label>()

regPatBox(box _b) =>
    if not na(_b)
        array.push(patBoxReg, _b)
        if array.size(patBoxReg) > maxPatBoxes
            box.delete(array.shift(patBoxReg))

regLine(line _l) =>
    if not na(_l)
        array.push(regLines, _l)
        if array.size(regLines) > 500
            line.delete(array.shift(regLines))

regLabel(label _lb) =>
    if not na(_lb)
        array.push(regLabels, _lb)
        if array.size(regLabels) > 500
            label.delete(array.shift(regLabels))

// R:R zone boxes (2 ต่อเทรด) — แยก registry จาก pattern box, รวมกันไม่เกิน 500 ตาม Pine
var array<box> zoneBoxReg = array.new<box>()
int maxZoneBoxes = math.max(20, 490 - maxPatBoxes)
regZoneBox(box _b) =>
    if not na(_b)
        array.push(zoneBoxReg, _b)
        if array.size(zoneBoxReg) > maxZoneBoxes
            box.delete(array.shift(zoneBoxReg))

// --- Pending plan arrays ---
var array<bool>  pIsBuy    = array.new_bool()
var array<float> pBreakLvl = array.new_float()
var array<float> pPbTarget = array.new_float()
var array<float> pTop      = array.new_float()
var array<float> pBot      = array.new_float()
var array<float> pRange    = array.new_float()
var array<int>   pCreateBar= array.new_int()
var array<int>   pState    = array.new_int()   // 0 = wait break (limit), 1 = wait pullback fill
var array<bool>  pAnyBreak = array.new_bool()  // true = break-either-way plan (direction set on break)
var array<int>   pType     = array.new_int()   // 0 = pullback, 1 = mid-level
var array<line>  pLine     = array.new_line()
var array<label> pLabel    = array.new_label()
var array<label> pWaitLabel= array.new<label>()
// preview TP/SL — ชุดเดียว โชว์เฉพาะ plan ล่าสุดที่ยังไม่ fill (เส้นประสั้นทางขวา + ป้ายราคา)
var line  gTpLine = na
var line  gSlLine = na
var label gTpTag  = na
var label gSlTag  = na

// --- Active trade arrays ---
var array<bool>  tIsBuy     = array.new_bool()
var array<float> tEntry     = array.new_float()
var array<float> tSL        = array.new_float()
var array<float> tTP        = array.new_float()
var array<int>   tBarIdx    = array.new_int()
var array<float> tPipsDist  = array.new_float()
var array<float> tTradeRR   = array.new_float()
var array<int>   tOriginTime= array.new_int()
var array<int>   tType      = array.new_int()
var array<label> tHoldLabel = array.new<label>()

// --- Per-trade drawing handles ---
type TradeArt
    array<line>  lns
    array<label> lbs
    array<box>   bxs
var array<TradeArt> tArt = array.new<TradeArt>()

f_deleteArt(TradeArt _a) =>
    if not na(_a)
        if array.size(_a.lns) > 0
            for k = 0 to array.size(_a.lns) - 1
                line.delete(array.get(_a.lns, k))
        if array.size(_a.lbs) > 0
            for k = 0 to array.size(_a.lbs) - 1
                label.delete(array.get(_a.lbs, k))
        if array.size(_a.bxs) > 0
            for k = 0 to array.size(_a.bxs) - 1
                box.delete(array.get(_a.bxs, k))

f_fadeArt(TradeArt _a) =>
    if not na(_a)
        color _fadeLn = color.new(vMuted, 70)
        if array.size(_a.lns) > 0
            for k = 0 to array.size(_a.lns) - 1
                line.set_style(array.get(_a.lns, k), line.style_dashed)
                line.set_color(array.get(_a.lns, k), _fadeLn)
                line.set_width(array.get(_a.lns, k), 1)
        if array.size(_a.lbs) > 0
            for k = 0 to array.size(_a.lbs) - 1
                label.set_color(array.get(_a.lbs, k), color.new(vMuted, 90))
                label.set_textcolor(array.get(_a.lbs, k), color.new(vMuted, 70))
        if array.size(_a.bxs) > 0
            for k = 0 to array.size(_a.bxs) - 1
                box.set_bgcolor(array.get(_a.bxs, k), color.new(vMuted, 92))
                box.set_border_color(array.get(_a.bxs, k), color.new(vMuted, 80))
                box.set_border_style(array.get(_a.bxs, k), line.style_dashed)

// --- Helpers for plan label text (3 บรรทัด อ่านเร็ว: ประเภทออเดอร์ / ราคาเข้า / SL) ---
f_px(float _p) => str.tostring(_p, priceFmt)

f_planLimitText(bool _isB, float _entry, float _sl) =>
    "รอ " + (_isB ? "BUY LIMIT" : "SELL LIMIT") + "\nที่ราคา " + f_px(_entry) + "\nSL ที่  " + f_px(_sl)

// Label แบบ "ป้ายหมึก" — พื้นเข้ม ตัวอักษรสี ใช้ font monospace ให้ตัวเลขเรียงตรง
f_inkLabel(int _x, float _y, string _txt, string _style, color _txtCol, string _size) =>
    label.new(xloc=xloc.bar_time, x=_x, y=_y, text=_txt, style=_style, color=vInkBg, textcolor=_txtCol, size=_size, text_font_family=font.family_monospace)

// Label แบบ "ป้ายทึบ" — พื้นสีเต็ม ใช้กับผลลัพธ์ Win/Loss ให้เด่น
f_solidLabel(int _x, float _y, string _txt, string _style, color _bg, color _txtCol, string _size) =>
    label.new(xloc=xloc.bar_time, x=_x, y=_y, text=_txt, style=_style, color=_bg, textcolor=_txtCol, size=_size, text_font_family=font.family_monospace)

// Label แบบ "price tag" (เล็ก โปร่ง 80 ตัวอักษรสี — ตาม reference)
f_priceTag(int _x, float _y, string _txt, color _col) =>
    label.new(xloc=xloc.bar_time, x=_x, y=_y, text=_txt, style=label.style_label_left, color=color.new(_col, 80), textcolor=_col, size=lblSz, text_font_family=font.family_monospace)

// เส้น preview TP/SL ของ plan — เส้นประสั้นๆ ทางขวาของแท่งปัจจุบัน + ป้ายราคา (ไม่บังแท่งเทียน)
planPrevLen = 4   // ความยาวเส้น preview (แท่ง) — สั้นๆ
f_planPrevLine(float _y, color _col) =>
    int _x1 = time + labelOffset * MS30
    line.new(xloc=xloc.bar_time, x1=_x1, y1=_y, x2=_x1 + planPrevLen * MS30, y2=_y, color=color.new(_col, 20), width=1, style=line.style_dashed)


// ==========================================
// --- 2B. M30 ENGINE FEED (MTF LOCK) ---
// ==========================================
// V2: เอนจินคำนวณจากแท่ง M30 ที่ "ปิดแล้ว" เสมอ ไม่ว่ากราฟจะเปิด TF ไหน จุดเข้า-ออก order จึงเป็นของ M30 เท่านั้น
//  - Chart TF > M30  → request.security_lower_tf ดึงแท่ง M30 ทุกแท่งที่อยู่ในแท่งกราฟ
//  - Chart TF <= M30 → ตรวจจบคาบ M30 ด้วย time("30") แล้วดึง OHLC แท่งที่ปิดแบบ non-repainting
// การวาดทั้งหมดใช้ xloc.bar_time → ตำแหน่งอิงเวลา ตรงกันทุก TF
// ข้อจำกัด TradingView: ข้อมูล intrabar ~100k แท่ง M30 → TF สูงมากเห็นประวัติย้อนหลังสั้นลง

bool chartAbove30 = timeframe.in_seconds(timeframe.period) > 1800

[ltfH30, ltfL30, ltfC30, ltfT30] = request.security_lower_tf(syminfo.tickerid, chartAbove30 ? "30" : timeframe.period, [high, low, close, time])

int m30Period = time("30")
bool m30Closed = not chartAbove30 and not na(m30Period[1]) and m30Period != m30Period[1]
[scH, scL, scC, scT] = request.security(syminfo.tickerid, "30", [high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)

// แท่ง M30 ที่ปิดสมบูรณ์บนแท่งกราฟนี้ (0, 1 หรือหลายแท่ง)
array<float> feedH = array.new_float()
array<float> feedL = array.new_float()
array<float> feedC = array.new_float()
array<int>   feedT = array.new_int()
var int lastFedT = 0

if chartAbove30
    int nIntra = array.size(ltfT30)
    int nUse = barstate.isconfirmed ? nIntra : math.max(nIntra - 1, 0)
    if nUse > 0
        for fk = 0 to nUse - 1
            int fT = array.get(ltfT30, fk)
            if fT > lastFedT
                array.push(feedH, array.get(ltfH30, fk))
                array.push(feedL, array.get(ltfL30, fk)), array.push(feedC, array.get(ltfC30, fk))
                array.push(feedT, fT)
                lastFedT := fT
else if m30Closed and not na(scT) and scT > lastFedT
    array.push(feedH, scH), array.push(feedL, scL), array.push(feedC, scC), array.push(feedT, scT)
    lastFedT := scT


var float dowPrevSwingLo = na
var float dowLastSwingLo = na
var float dowPrevSwingHi = na
var float dowLastSwingHi = na
var string swSeq1 = na
var float  swPx1  = na
var int    swBr1  = na
var string swSeq2 = na
var float  swPx2  = na
var int    swBr2  = na
var string swSeq3 = na
var float  swPx3  = na
var int    swBr3  = na

// ==========================================
// --- ENGINE LOOP: ประมวลผลต่อแท่ง M30 ที่ปิดแล้ว (sections 3-5) ---
// ==========================================
if array.size(feedT) > 0
    for mIdx = 0 to array.size(feedT) - 1
        float mH = array.get(feedH, mIdx)
        float mL = array.get(feedL, mIdx)
        float mC = array.get(feedC, mIdx)
        int   mT = array.get(feedT, mIdx)
        // --- rolling window + M30 ATR ---
        array.push(mqH, mH), array.push(mqL, mL), array.push(mqT, mT)
        if array.size(mqH) > 64
            array.shift(mqH), array.shift(mqL), array.shift(mqT)
        float mTR = na(m30PrevC) ? mH - mL : math.max(mH - mL, math.max(math.abs(mH - m30PrevC), math.abs(mL - m30PrevC)))
        m30Atr   := na(m30Atr) ? mTR : (m30Atr * (oneRAtrPeriod - 1) + mTR) / oneRAtrPeriod
        oneRAtr  := m30Atr * oneRAtrMult
        m30PrevC := mC
        // --- pivot high/low คำนวณเองบนแท่ง M30 (pivot ของ chart TF ใช้ไม่ได้ใน MTF) ---
        float dowPivHi = na
        float dowPivLo = na
        int   pivT     = na
        int mqN = array.size(mqH)
        if mqN >= dowSwingLen * 2 + 1
            int cIdx = mqN - 1 - dowSwingLen
            float cH = array.get(mqH, cIdx)
            float cL = array.get(mqL, cIdx)
            bool isPH = true
            bool isPL = true
            for pj = cIdx - dowSwingLen to cIdx + dowSwingLen
                if pj != cIdx
                    if array.get(mqH, pj) >= cH
                        isPH := false
                    if array.get(mqL, pj) <= cL
                        isPL := false
            if isPH
                dowPivHi := cH
            if isPL
                dowPivLo := cL
            pivT := array.get(mqT, cIdx)

        // ==========================================
        // --- 3. SWING TRACKING & PATTERN DETECTION ---
        // ==========================================




        bool  newSellPattern = false
        bool  newBuyPattern  = false
        float patBoxTop  = na
        float patBoxBot  = na
        int   patBoxLeft = na

        // --- Swing High detection ---
        if not na(dowPivHi)
            dowPrevSwingHi := dowLastSwingHi
            dowLastSwingHi := dowPivHi
            bool isHH = not na(dowPrevSwingHi) and dowLastSwingHi > dowPrevSwingHi
            bool isLH = not na(dowPrevSwingHi) and dowLastSwingHi < dowPrevSwingHi
            if showDowLabels
                string hlbl = isHH ? "HH" : isLH ? "LH" : "H"
                color  hcol = isHH ? color.new(vBull, 25) : isLH ? color.new(vBear, 25) : color.new(vMuted, 35)
                // ตัวอักษรลอย ไม่มีพื้น — โครงสร้าง swing เป็นแค่บริบท ไม่แย่งความสนใจ
                regLabel(label.new(xloc=xloc.bar_time, x=pivT, y=dowPivHi + 15 * syminfo.mintick, text=hlbl, style=label.style_label_down, color=vNone, textcolor=hcol, size=lblSz, text_font_family=font.family_monospace))
            if isHH or isLH
                swSeq1 := swSeq2, swPx1 := swPx2, swBr1 := swBr2
                swSeq2 := swSeq3, swPx2 := swPx3, swBr2 := swBr3
                swSeq3 := isHH ? "HH" : "LH"
                swPx3  := dowPivHi
                swBr3  := pivT
                if swSeq3 == "HH" and swSeq2 == "LL" and (swSeq1 == "LH" or swSeq1 == "HH")
                    newBuyPattern := true
                    patBoxTop  := swPx3
                    patBoxBot  := swPx2
                    patBoxLeft := swBr1

        // --- Swing Low detection ---
        if not na(dowPivLo)
            dowPrevSwingLo := dowLastSwingLo
            dowLastSwingLo := dowPivLo
            bool isHL = not na(dowPrevSwingLo) and dowLastSwingLo > dowPrevSwingLo
            bool isLL = not na(dowPrevSwingLo) and dowLastSwingLo < dowPrevSwingLo
            if showDowLabels
                string llbl = isHL ? "HL" : isLL ? "LL" : "L"
                color  lcol = isHL ? color.new(vBull, 25) : isLL ? color.new(vBear, 25) : color.new(vMuted, 35)
                regLabel(label.new(xloc=xloc.bar_time, x=pivT, y=dowPivLo - 15 * syminfo.mintick, text=llbl, style=label.style_label_up, color=vNone, textcolor=lcol, size=lblSz, text_font_family=font.family_monospace))
            if isHL or isLL
                swSeq1 := swSeq2, swPx1 := swPx2, swBr1 := swBr2
                swSeq2 := swSeq3, swPx2 := swPx3, swBr2 := swBr3
                swSeq3 := isHL ? "HL" : "LL"
                swPx3  := dowPivLo
                swBr3  := pivT
                if swSeq3 == "LL" and swSeq2 == "HH" and (swSeq1 == "HL" or swSeq1 == "LL")
                    newSellPattern := true
                    patBoxTop  := swPx2
                    patBoxBot  := swPx3
                    patBoxLeft := swBr1

        // ==========================================
        // --- 4. PATTERN BOX + PLAN CREATION ---
        // ==========================================

        if (newSellPattern or newBuyPattern) and not na(patBoxTop) and not na(patBoxBot) and patBoxTop > patBoxBot
            bool isB = newBuyPattern
            color patCol = breakEitherWay ? vRange : (isB ? vBull : vBear)
            string patName = (breakEitherWay ? "RANGE ⇅" : (isB ? "▲ BUY" : "▼ SELL")) + "  " + swSeq1 + "·" + swSeq2 + "·" + swSeq3
            float rng = patBoxTop - patBoxBot
            int patDow = dayofweek(mT, tz)
            bool tradeDayAllowed = switch patDow
                dayofweek.sunday    => tradeSun
                dayofweek.monday    => tradeMon
                dayofweek.tuesday   => tradeTue
                dayofweek.wednesday => tradeWed
                dayofweek.thursday  => tradeThu
                dayofweek.friday    => tradeFri
                =>                     tradeSat
            string dowName = patDow == dayofweek.sunday ? "Sun" : patDow == dayofweek.monday ? "Mon" : patDow == dayofweek.tuesday ? "Tue" : patDow == dayofweek.wednesday ? "Wed" : patDow == dayofweek.thursday ? "Thu" : patDow == dayofweek.friday ? "Fri" : "Sat"


            // --- Pattern box ---
            if showPatternBox
                // กรอบบาง พื้นจางมาก ชื่อ pattern มุมซ้ายบน — ไม่บังแท่งเทียน
                regPatBox(box.new(xloc=xloc.bar_time, left=patBoxLeft, top=patBoxTop, right=mT, bottom=patBoxBot, bgcolor=color.new(patCol, 92), border_color=color.new(patCol, 45), border_width=1, border_style=breakEitherWay ? line.style_dashed : line.style_solid, text=patName, text_size=size.tiny, text_color=color.new(patCol, 15), text_halign=text.align_left, text_valign=text.align_top, text_font_family=font.family_monospace))

            // --- Create pending Pullback% plan ---
            bool midOnlyMode = useMidLevel and midOnly
            if not tradeDayAllowed
                regLabel(f_inkLabel(mT + inkOff * MS30, (patBoxTop + patBoxBot) / 2, "NO TRADE · " + dowName, label.style_label_left, color.new(vMuted, 20), lblSz))
            else if not midOnlyMode and breakEitherWay
                // Mode B: neutral range plan — show both possible stop orders
                float slUp   = slEdgeMode ? patBoxBot : patBoxTop - oneRDistOf(rng)
                float slDn   = slEdgeMode ? patBoxTop : patBoxBot + oneRDistOf(rng)
                array.push(pIsBuy, false)
                array.push(pBreakLvl, na)
                array.push(pPbTarget, na)
                array.push(pTop, patBoxTop)
                array.push(pBot, patBoxBot)
                array.push(pRange, rng)
                array.push(pCreateBar, mT)
                array.push(pState, 0)
                array.push(pAnyBreak, true)
                array.push(pType, 0)
                array.push(pLine, na)
                array.push(pLabel, na)
                array.push(pWaitLabel, f_inkLabel(mT + inkOff * MS30, (patBoxTop + patBoxBot) / 2, "รอเบรค ⇅ 2 ทาง", label.style_label_left, color.black, lblSz))
            else if not midOnlyMode
                // Mode A: direction fixed by the pattern.
                float breakLvl = isB ? patBoxTop : patBoxBot
                float pbDist   = pullbackMode == "% of Range" ? rng * (pullbackRangePct / 100) : breakLvl * (pullbackPct / 100)
                float pbTarget = isB ? patBoxTop - pbDist : patBoxBot + pbDist
                float slStop   = slEdgeMode ? (isB ? patBoxBot : patBoxTop) : (isB ? breakLvl - oneRDistOf(rng) : breakLvl + oneRDistOf(rng))
                // แผน Pullback (gold) — เส้นประหนายาว (แบบ reference) ที่ระดับ stop order
                line  plLn = line.new(xloc=xloc.bar_time, x1=mT, y1=breakLvl, x2=mT + (labelOffset + 10) * MS30, y2=breakLvl, color=color.new(vPlan, 10), width=2, style=line.style_dashed)
                array.push(pIsBuy, isB)
                array.push(pBreakLvl, breakLvl)
                array.push(pPbTarget, pbTarget)
                array.push(pTop, patBoxTop)
                array.push(pBot, patBoxBot)
                array.push(pRange, rng)
                array.push(pCreateBar, mT)
                array.push(pState, 0)
                array.push(pAnyBreak, false)
                array.push(pType, 0)
                array.push(pLine, plLn)
                array.push(pLabel, na)
                array.push(pWaitLabel, f_inkLabel(mT + inkOff * MS30, breakLvl, (isB ? "รอเบรคจุดนี้ก่อน เพื่อรอตั้ง Buy Limit ที่ราคา " : "รอเบรคจุดนี้ก่อน เพื่อรอตั้ง Sell Limit ที่ราคา ") + f_px(breakLvl), label.style_label_left, color.black, lblSz))
                // --- Alert: new order plan created (Pullback) ---
                alert("ออเดอร์ใหม่ · " + (isB ? "BUY" : "SELL") + " (Pullback)\nรอเบรคที่: " + f_px(breakLvl) + "\nEntry (จุดย่อกลับ): " + f_px(pbTarget), alert.freq_once_per_bar)

            // --- Mid-Level parallel entry ---
            if useMidLevel and tradeDayAllowed
                bool  makeMid  = false
                bool  midBuy   = false
                float midEnt   = na
                float midPctUse = midEntryPct
                if midDualSide
                    midPctUse := math.min(midEntryPct, 50)
                    float buyLvl  = patBoxTop - rng * (midPctUse / 100)
                    float sellLvl = patBoxBot + rng * (midPctUse / 100)
                    bool  canBuy  = mC > buyLvl
                    bool  canSell = mC < sellLvl
                    if canBuy or canSell
                        midBuy  := canBuy
                        midEnt  := canBuy ? buyLvl : sellLvl
                        makeMid := true
                else
                    midBuy := newBuyPattern
                    midEnt := midBuy ? patBoxTop - rng * (midEntryPct / 100) : patBoxBot + rng * (midEntryPct / 100)
                    makeMid := midBuy ? (mC > midEnt) : (mC < midEnt)
                if makeMid
                    float slMid = midSlMode == "Box Edge" ? (midBuy ? patBoxBot : patBoxTop) : (midBuy ? midEnt - rng * (midSlPct / 100) : midEnt + rng * (midSlPct / 100))
                    // แผน Mid-Level (cyan) — เส้นประหนายาว (แบบ reference) ที่ระดับ limit
                    line  mLn = line.new(xloc=xloc.bar_time, x1=mT, y1=midEnt, x2=mT + (labelOffset + 10) * MS30, y2=midEnt, color=color.new(vMid, 10), width=2, style=line.style_dashed)
                    array.push(pIsBuy, midBuy)
                    array.push(pBreakLvl, na)
                    array.push(pPbTarget, midEnt)
                    array.push(pTop, patBoxTop)
                    array.push(pBot, patBoxBot)
                    array.push(pRange, rng)
                    array.push(pCreateBar, mT)
                    array.push(pState, 1)
                    array.push(pAnyBreak, false)
                    array.push(pType, 1)
                    array.push(pLine, mLn)
                    array.push(pLabel, na)
                    array.push(pWaitLabel, f_inkLabel(mT + inkOff * MS30, midEnt, "รอ " + (midBuy ? "BUY" : "SELL") + " LIMIT ที่นี่ · " + f_px(midEnt), label.style_label_left, color.black, lblSz))
                    // --- Alert: new order plan created (Mid-Level) ---
                    alert("ออเดอร์ใหม่ · " + (midBuy ? "BUY" : "SELL") + " LIMIT (Mid-Level)\nEntry: " + f_px(midEnt) + "\nSL: " + f_px(slMid), alert.freq_once_per_bar)

        // ==========================================
        // --- 5. PLAN STATE MACHINE (break → pullback → fill) ---
        // ==========================================

        if array.size(pState) > 0
            int pi = array.size(pState) - 1
            while pi >= 0
                bool  isB = array.get(pIsBuy, pi)
                int   st  = array.get(pState, pi)
                bool  anyBrk = array.get(pAnyBreak, pi)
                int   ptype  = array.get(pType, pi)
                float brk = array.get(pBreakLvl, pi)
                float pbT = array.get(pPbTarget, pi)
                bool  expired = (mT - array.get(pCreateBar, pi)) > planExpireBars * MS30
                bool  sameBar = array.get(pCreateBar, pi) == mT
                bool  removePlan = false
                line plnLn = array.get(pLine, pi)
                if not na(plnLn)
                    line.set_x2(plnLn, mT + (labelOffset + 10) * MS30)
                if expired
                    line.delete(array.get(pLine, pi))
                    label.delete(array.get(pLabel, pi))
                    label.delete(array.get(pWaitLabel, pi))
                    removePlan := true
                else if not sameBar and st == 0 and anyBrk
                    // Mode B: neutral range — resolve direction on whichever edge breaks first.
                    float tp_ = array.get(pTop, pi)
                    float bt_ = array.get(pBot, pi)
                    bool brokeUp = mH > tp_
                    bool brokeDn = mL < bt_
                    if brokeUp or brokeDn
                        bool dirBuy = brokeUp
                        float bl   = dirBuy ? tp_ : bt_
                        float rngv = array.get(pRange, pi)
                        float pbd  = pullbackMode == "% of Range" ? rngv * (pullbackRangePct / 100) : bl * (pullbackPct / 100)
                        float pbt  = dirBuy ? tp_ - pbd : bt_ + pbd
                        float slLim = slEdgeMode ? (dirBuy ? bt_ : tp_) : (dirBuy ? pbt - oneRDistOf(rngv) : pbt + oneRDistOf(rngv))
                        array.set(pIsBuy, pi, dirBuy)
                        array.set(pBreakLvl, pi, bl)
                        array.set(pPbTarget, pi, pbt)
                        array.set(pState, pi, 1)
                        // เบรคแล้ว → กลายเป็น limit order (gold เส้นประหนายาว)
                        line nl = line.new(xloc=xloc.bar_time, x1=mT, y1=pbt, x2=mT + (labelOffset + 10) * MS30, y2=pbt, color=color.new(vPlan, 5), width=2, style=line.style_dashed)
                        array.set(pLine, pi, nl)
                        label lb0 = array.get(pLabel, pi)
                        if not na(lb0)
                            label.set_xy(lb0, mT + inkOff * MS30, pbt)
                            label.set_style(lb0, label.style_label_left)
                            label.set_text(lb0, f_planLimitText(dirBuy, pbt, slLim))
                            label.set_textcolor(lb0, vPlan)
                        label wl0 = array.get(pWaitLabel, pi)
                        if not na(wl0)
                            label.set_xy(wl0, mT + inkOff * MS30, pbt)
                            label.set_text(wl0, "รอ " + (dirBuy ? "BUY" : "SELL") + " LIMIT ที่นี่ · " + f_px(pbt))
                            label.set_textcolor(wl0, vPlan)
                else if not sameBar and st == 0
                    // Mode A Pullback: State 0 → wait for the box edge to break
                    bool broke = isB ? (mH > brk) : (mL < brk)
                    if broke
                        float rngv2 = array.get(pRange, pi)
                        float slLim2 = slEdgeMode ? (isB ? array.get(pBot, pi) : array.get(pTop, pi)) : (isB ? pbT - oneRDistOf(rngv2) : pbT + oneRDistOf(rngv2))
                        array.set(pState, pi, 1)
                        line pl2 = array.get(pLine, pi)
                        if not na(pl2)
                            line.set_y1(pl2, pbT)
                            line.set_y2(pl2, pbT)
                            line.set_color(pl2, color.new(vPlan, 5))
                            line.set_style(pl2, line.style_dashed)
                            line.set_width(pl2, 2)
                        label lb2 = array.get(pLabel, pi)
                        if not na(lb2)
                            label.set_y(lb2, pbT)
                            label.set_x(lb2, mT + inkOff * MS30)
                            label.set_style(lb2, label.style_label_left)
                            label.set_text(lb2, f_planLimitText(isB, pbT, slLim2))
                        label wl2 = array.get(pWaitLabel, pi)
                        if not na(wl2)
                            label.set_xy(wl2, mT + inkOff * MS30, pbT)
                            label.set_text(wl2, "รอ " + (isB ? "BUY" : "SELL") + " LIMIT ที่นี่ · " + f_px(pbT))
                else if not sameBar and st == 1
                    // State 1: either Pullback wait-fill or Mid-Level wait-fill
                    bool midCancel = false
                    if ptype == 1
                        bool brokeOut = isB ? (mH > array.get(pTop, pi)) : (mL < array.get(pBot, pi))
                        bool willFill = isB ? (mL <= pbT) : (mH >= pbT)
                        midCancel := brokeOut and not willFill
                    if midCancel
                        regLabel(f_inkLabel(mT + inkOff * MS30, pbT, "ยกเลิก MID\n(เบรคกรอบ)", label.style_label_left, color.new(vMuted, 20), lblSz))
                        regLine(line.new(xloc=xloc.bar_time, x1=array.get(pCreateBar, pi), y1=pbT, x2=mT, y2=pbT, color=color.new(vMuted, 70), width=1, style=line.style_dashed))
                        line.delete(array.get(pLine, pi))
                        label.delete(array.get(pLabel, pi))
                        label.delete(array.get(pWaitLabel, pi))
                        removePlan := true
                    bool reached = not midCancel and (isB ? mL <= pbT : mH >= pbT)
                    if reached
                        float rng  = array.get(pRange, pi)
                        float top  = array.get(pTop, pi)
                        float bot  = array.get(pBot, pi)
                        float ent  = pbT + (isB ? spreadPts : -spreadPts)
                        [oneR, sl, tp] = f_planLevels(isB, ptype, ent, top, bot, rng)
                        float lot  = oneR > 0 ? riskAmount / (oneR * pipValueRatio) : 0
                        float trr  = oneR > 0 ? math.abs(tp - ent) / oneR : 0
                        array.push(tIsBuy, isB)
                        array.push(tEntry, ent)
                        array.push(tSL, sl)
                        array.push(tTP, tp)
                        array.push(tBarIdx, mT)
                        array.push(tPipsDist, oneR)
                        array.push(tTradeRR, trr)
                        array.push(tOriginTime, mT)
                        array.push(tType, ptype)
                        // --- Alert: order filled ---
                        string _alertType = ptype == 1 ? "LIMIT (Mid-Level)" : "LIMIT (Pullback)"
                        alert((isB ? "BUY " : "SELL ") + _alertType + "\nEntry: " + f_px(ent) + "\nSL: " + f_px(sl) + "\nTP: " + f_px(tp) + "\nLot: " + str.tostring(lot, "#.####") + "\nR:R: " + str.tostring(trr, "#.##"), alert.freq_once_per_bar)
                        // ---------- Trade visual (ออกแบบเป็นชุดเดียว, track handle ต่อเทรด) ----------
                        color dirCol = isB ? vBull : vBear
                        int   zoneR  = mT + tpSlMarkerLen * MS30
                        TradeArt art = TradeArt.new(array.new<line>(), array.new<label>(), array.new<box>())
                        // 1) เส้นโยงจากจุดสร้างแผน → จุดเข้า (จางมาก แค่บอกที่มา)
                        if showTrailLine
                            line tl1 = line.new(xloc=xloc.bar_time, x1=array.get(pCreateBar, pi), y1=ent, x2=mT, y2=ent, color=color.new(ptype == 1 ? vMid : vPlan, 70), width=1, style=line.style_dotted)
                            regLine(tl1), array.push(art.lns, tl1)
                        // 2) R:R Zone — กล่องโปร่ง entry→TP (เขียว) / entry→SL (แดง) แบบเครื่องมือ Long/Short Position
                        if tradeVisual != "Arrows"
                            box tb1 = box.new(xloc=xloc.bar_time, left=mT, top=math.max(ent, tp), right=zoneR, bottom=math.min(ent, tp), bgcolor=color.new(vBull, 84), border_color=color.new(vBull, 70), border_width=1)
                            box tb2 = box.new(xloc=xloc.bar_time, left=mT, top=math.max(ent, sl), right=zoneR, bottom=math.min(ent, sl), bgcolor=color.new(vBear, 84), border_color=color.new(vBear, 70), border_width=1)
                            regZoneBox(tb1), array.push(art.bxs, tb1)
                            regZoneBox(tb2), array.push(art.bxs, tb2)
                        // 3a) เส้นประโยง entry ↔ TP / SL (แสดงเสมอ — เชื่อมออเดอร์)
                        line tlDashTp = line.new(xloc=xloc.bar_time, x1=mT, y1=ent, x2=mT, y2=tp, color=color.new(vBull, 50), width=1, style=line.style_dashed)
                        line tlDashSl = line.new(xloc=xloc.bar_time, x1=mT, y1=ent, x2=mT, y2=sl, color=color.new(vBear, 50), width=1, style=line.style_dashed)
                        regLine(tlDashTp), array.push(art.lns, tlDashTp)
                        regLine(tlDashSl), array.push(art.lns, tlDashSl)
                        // 3b) ลูกศรแนวตั้ง entry → TP / SL (โหมด Arrows / Both)
                        if tradeVisual != "R:R Zone"
                            line tl2 = line.new(xloc=xloc.bar_time, x1=mT, y1=ent, x2=mT, y2=tp, color=color.new(vBull, tpSlBrightness), width=tpSlArrowWidth, style=line.style_arrow_right)
                            line tl3 = line.new(xloc=xloc.bar_time, x1=mT, y1=ent, x2=mT, y2=sl, color=color.new(vBear, tpSlBrightness), width=tpSlArrowWidth, style=line.style_arrow_right)
                            regLine(tl2), array.push(art.lns, tl2)
                            regLine(tl3), array.push(art.lns, tl3)
                        // 4) ขีดแนวนอนสั้น 3 เส้นที่ระดับ entry / TP / SL (แบบ reference — width=2 alpha 30)
                        line tl4 = line.new(xloc=xloc.bar_time, x1=mT, y1=tp, x2=zoneR, y2=tp, color=color.new(vBull, tpSlBrightness), width=tpSlMarkerWidth, style=line.style_solid)
                        line tl5 = line.new(xloc=xloc.bar_time, x1=mT, y1=sl, x2=zoneR, y2=sl, color=color.new(vBear, tpSlBrightness), width=tpSlMarkerWidth, style=line.style_solid)
                        line tl6 = line.new(xloc=xloc.bar_time, x1=mT, y1=ent, x2=zoneR, y2=ent, color=color.new(vEntry, tpSlBrightness), width=tpSlMarkerWidth, style=line.style_solid)
                        regLine(tl4), array.push(art.lns, tl4)
                        regLine(tl5), array.push(art.lns, tl5)
                        regLine(tl6), array.push(art.lns, tl6)
                        // 5) ป้ายราคา entry / TP / SL — เล็ก โปร่ง 80 ตัวอักษรสี (แบบ reference — ไม่มีคำนำหน้า)
                        label tlbEnt = f_priceTag(zoneR, ent, f_px(ent), vEntry)
                        label tlbTp  = f_priceTag(zoneR, tp,  f_px(tp),  vBull)
                        label tlbSl  = f_priceTag(zoneR, sl,  f_px(sl),  vBear)
                        regLabel(tlbEnt), array.push(art.lbs, tlbEnt)
                        regLabel(tlbTp),  array.push(art.lbs, tlbTp)
                        regLabel(tlbSl),  array.push(art.lbs, tlbSl)
                        // 6) วงกลมใหญ่ที่จุดเข้า — บอกทิศทางออเดอร์ (แทนสามเหลี่ยม + BUY/SELL text)
                        if showEntryInfo
                            label tlbCirc = label.new(xloc=xloc.bar_time, x=mT, y=ent, text="", style=label.style_circle, color=color.new(vEntry, 30), size=entryArrowSz)
                            regLabel(tlbCirc), array.push(art.lbs, tlbCirc)
                        // 7) วงกลมเล็กที่ TP และ SL — เชื่อมกับเส้นประ
                        label tlbCircTp = label.new(xloc=xloc.bar_time, x=mT, y=tp, text="", style=label.style_circle, color=color.new(vBull, 30), size=size.small)
                        label tlbCircSl = label.new(xloc=xloc.bar_time, x=mT, y=sl, text="", style=label.style_circle, color=color.new(vBear, 30), size=size.small)
                        regLabel(tlbCircTp), array.push(art.lbs, tlbCircTp)
                        regLabel(tlbCircSl), array.push(art.lbs, tlbCircSl)
                        array.push(tArt, art)
                        // 8) ป้าย "กำลังถือ" — แสดงขณะเทรดเปิดอยู่ ลบเมื่อ TP/SL
                        label holdLb = f_inkLabel(mT + inkOff * MS30, ent, "กำลังถือ " + (isB ? "BUY" : "SELL") + "\nรอผล TP/SL", label.style_label_left, vEntry, lblSz)
                        array.push(tHoldLabel, holdLb)
                        line.delete(array.get(pLine, pi))
                        label.delete(array.get(pLabel, pi))
                        label.delete(array.get(pWaitLabel, pi))
                        removePlan := true
                if removePlan
                    array.remove(pIsBuy, pi), array.remove(pBreakLvl, pi), array.remove(pPbTarget, pi)
                    array.remove(pTop, pi), array.remove(pBot, pi), array.remove(pRange, pi)
                    array.remove(pCreateBar, pi), array.remove(pState, pi), array.remove(pAnyBreak, pi), array.remove(pType, pi), array.remove(pLine, pi), array.remove(pLabel, pi), array.remove(pWaitLabel, pi)
                pi -= 1


// --- Update holding labels to stay in front of candles ---
if array.size(tHoldLabel) > 0
    for k = 0 to array.size(tHoldLabel) - 1
        label hl = array.get(tHoldLabel, k)
        if not na(hl)
            label.set_x(hl, time + inkOff * MS30)

// --- เลือกออเดอร์ที่ยังไม่ fill ซึ่งใกล้ราคาปัจจุบันที่สุด 1 ตัว แล้วโชว์เฉพาะตัวนั้น ---
int   gSel  = -1
float gBest = na
if array.size(pState) > 0
    for k = 0 to array.size(pState) - 1
        float brkK = array.get(pBreakLvl, k)
        float pbK  = array.get(pPbTarget, k)
        float lvlK = array.get(pState, k) == 0 and not na(brkK) ? brkK : not na(pbK) ? pbK : (array.get(pTop, k) + array.get(pBot, k)) / 2
        float dK   = math.abs(lvlK - close)
        if na(gBest) or dK < gBest
            gBest := dK
            gSel  := k
// ป้ายสถานะ (แถวเดียว ตัวหนังสือดำ) + เส้น entry — โชว์เฉพาะออเดอร์ที่เลือก ที่เหลือซ่อน
// V2: ซ่อนแผน Pullback ที่ยังรอเบรค (State 0) — ไม่บอกจุด breakout ให้ลูกค้าเห็น
if array.size(pWaitLabel) > 0
    for k = 0 to array.size(pWaitLabel) - 1
        bool  sel      = k == gSel
        bool  waitBrk  = array.get(pState, k) == 0 and array.get(pType, k) == 0
        bool  showWait = sel and not waitBrk
        label wl  = array.get(pWaitLabel, k)
        line  ln  = array.get(pLine, k)
        if not na(wl)
            label.set_x(wl, time + inkOff * MS30)
            label.set_textcolor(wl, showWait ? wlTextColor : color.new(wlTextColor, 100))
            label.set_color(wl, showWait ? wlBgColor : color.new(wlBgColor, 100))
        if not na(ln)
            color lncol = array.get(pType, k) == 1 ? vMid : vPlan
            line.set_color(ln, color.new(lncol, showWait ? 10 : 100))

// --- Preview TP/SL: เฉพาะออเดอร์ที่เลือก (ถ้ารู้จุดเข้าแล้ว) ---
bool gShow = false
if gSel != -1
    // V2: ไม่โชว์ preview TP/SL ตอน State 0 (Pullback ยังรอเบรค) — โชว์เฉพาะแผนที่ armed แล้ว (State 1)
    gShow := not na(array.get(pPbTarget, gSel)) and array.get(pState, gSel) == 1
if not gShow
    // ไม่มีออเดอร์/ยังไม่รู้จุดเข้า → ลบ preview
    line.delete(gTpLine), line.delete(gSlLine), label.delete(gTpTag), label.delete(gSlTag)
    gTpLine := na, gSlLine := na, gTpTag := na, gSlTag := na
else
    float gEnt = array.get(pPbTarget, gSel)
    [gOneR, gSl, gTp] = f_planLevels(array.get(pIsBuy, gSel), array.get(pType, gSel), gEnt, array.get(pTop, gSel), array.get(pBot, gSel), array.get(pRange, gSel))
    int gx1 = time + labelOffset * MS30
    int gx2 = gx1 + planPrevLen * MS30
    if na(gTpLine)
        gTpLine := f_planPrevLine(gTp, vBull)
        gSlLine := f_planPrevLine(gSl, vBear)
        gTpTag  := f_priceTag(gx2, gTp, "TP " + f_px(gTp), vBull)
        gSlTag  := f_priceTag(gx2, gSl, "SL " + f_px(gSl), vBear)
    else
        line.set_xy1(gTpLine, gx1, gTp), line.set_xy2(gTpLine, gx2, gTp)
        line.set_xy1(gSlLine, gx1, gSl), line.set_xy2(gSlLine, gx2, gSl)
        label.set_xy(gTpTag, gx2, gTp), label.set_text(gTpTag, "TP " + f_px(gTp))
        label.set_xy(gSlTag, gx2, gSl), label.set_text(gSlTag, "SL " + f_px(gSl))


// ==========================================
// --- ENGINE LOOP: ผลเทรดต่อแท่ง M30 ที่ปิดแล้ว (section 6) ---
// ==========================================
if array.size(feedT) > 0
    for mIdx = 0 to array.size(feedT) - 1
        float mH = array.get(feedH, mIdx)
        float mL = array.get(feedL, mIdx)
        int   mT = array.get(feedT, mIdx)

        // ==========================================
        // --- 6. TRADE RESULTS (win / loss) ---
        // ==========================================

        if array.size(tEntry) > 0
            int i = array.size(tEntry) - 1
            while i >= 0
                if mT >= array.get(tBarIdx, i)
                    bool  isB  = array.get(tIsBuy, i)
                    float ent  = array.get(tEntry, i)
                    float sl   = array.get(tSL, i)
                    float tp   = array.get(tTP, i)
                    float dist = array.get(tPipsDist, i)
                    float trr  = array.get(tTradeRR, i)
                    bool  entryBar = mT == array.get(tBarIdx, i)
                    bool  hitSL = isB ? mL <= sl : mH >= sl
                    bool  hitTP = isB ? mH >= tp : mL <= tp
                    bool closedWin  = false
                    bool closedLoss = false
                    if entryBar
                        // แท่งที่เพิ่งเข้าไม้: ไม่มีข้อมูล intrabar → ถ้าแตะ SL ในแท่งเดียวกัน นับ Loss (conservative)
                        if hitSL
                            closedLoss := true
                    else if hitSL and hitTP
                        // แตะทั้ง TP และ SL ในแท่ง M30 เดียวกัน → นับ Loss ไว้ก่อน (conservative)
                        closedLoss := true
                    else if hitSL
                        closedLoss := true
                    else if hitTP
                        closedWin := true
                    if closedWin or closedLoss
                        float lossR   = dist > 0 ? -(math.abs(ent - sl) / dist) : -1.0
                        float actualR = closedWin ? trr : lossR
                        bool  statWin = actualR > 0
                        float closePts = closedWin ? math.abs(tp - ent) : math.abs(sl - ent)
                        int   originT  = array.get(tOriginTime, i)
                        int   ttype    = array.get(tType, i)
                        string typeTxt = ttype == 1 ? "Mid" : "PB"
                        array.push(resIsWin, statWin)
                        array.push(resTradeRR, actualR)
                        array.push(resTime, originT)
                        array.push(resIsSmall, false)
                        array.push(resIsRec, false)
                        array.push(resTpPts, closePts)
                        if array.size(resIsWin) > 5000
                            array.shift(resIsWin), array.shift(resTradeRR), array.shift(resTime)
                            array.shift(resIsSmall), array.shift(resIsRec), array.shift(resTpPts)
                        // --- Alert: TP/SL hit ---
                        if closedWin
                            alert("WIN · " + typeTxt + " " + (isB ? "BUY" : "SELL") + "\nEntry: " + f_px(ent) + "\nTP: " + f_px(tp) + "\n+" + str.tostring(trr, "#.##") + "R", alert.freq_once_per_bar)
                        else
                            alert("LOSS · " + typeTxt + " " + (isB ? "BUY" : "SELL") + "\nEntry: " + f_px(ent) + "\nSL: " + f_px(sl) + "\n" + str.tostring(lossR, "#.##") + "R", alert.freq_once_per_bar)
                        // ลบป้าย "กำลังถือ"
                        if i < array.size(tHoldLabel)
                            label.delete(array.get(tHoldLabel, i))
                            array.remove(tHoldLabel, i)
                        // Visual ของเทรดที่จบ: fade เป็นเส้นประจาง หรือลบออก
                        if i < array.size(tArt)
                            if showClosedHistory
                                f_fadeArt(array.get(tArt, i))
                            else
                                f_deleteArt(array.get(tArt, i))
                        // ป้ายผล WIN / LOSS (แสดงเสมอ — ไม่มีเส้นแนวนอน)
                        if closedWin
                            regLabel(f_solidLabel(mT + labelOffset * MS30, tp, "WIN · " + typeTxt + "  +" + str.tostring(trr, "#.##") + "R", label.style_label_left, color.new(vBull, 5), vDarkTx, lblSz))
                        else
                            regLabel(f_solidLabel(mT + labelOffset * MS30, sl, "LOSS · " + typeTxt + "  " + str.tostring(lossR, "#.##") + "R", label.style_label_left, color.new(vBear, 5), color.rgb(255, 255, 255), lblSz))
                        if showClosedHistory and showTradePath
                            float closePx = closedWin ? tp : sl
                            color pathCol = closedWin ? color.new(vBull, 65) : color.new(vBear, 65)
                            regLine(line.new(xloc=xloc.bar_time, x1=array.get(tBarIdx, i), y1=ent, x2=mT, y2=closePx, color=pathCol, width=1, style=line.style_dashed))
                        array.remove(tIsBuy, i), array.remove(tEntry, i), array.remove(tSL, i), array.remove(tTP, i)
                        array.remove(tBarIdx, i), array.remove(tPipsDist, i), array.remove(tTradeRR, i), array.remove(tOriginTime, i), array.remove(tType, i)
                        if i < array.size(tArt)
                            array.remove(tArt, i)
                i -= 1


// ==========================================
// --- 7. STAT PERIOD HELPERS ---
// ==========================================

int targetMonthNum = statTargetM == "January" ? 1 : statTargetM == "February" ? 2 : statTargetM == "March" ? 3 : statTargetM == "April" ? 4 : statTargetM == "May" ? 5 : statTargetM == "June" ? 6 : statTargetM == "July" ? 7 : statTargetM == "August" ? 8 : statTargetM == "September" ? 9 : statTargetM == "October" ? 10 : statTargetM == "November" ? 11 : 12
int nDaysDraw     = math.min(statDays, array.size(dayList))
int cutoffDraw    = 0
if array.size(dayList) > 0
    cutoffDraw := array.get(dayList, array.size(dayList) - nDaysDraw)
int currentTotalM = year(timenow, tz) * 12 + month(timenow, tz)

// ==========================================
// --- 8. LUXE TABLE THEME ---
// ==========================================

color lxGold    = color.rgb(212, 175, 55)
color lxTitleTx = color.rgb(236, 210, 140)
color lxHeadBg  = color.new(color.rgb(26, 32, 52), 6)
color lxSubBg   = color.new(color.rgb(19, 24, 40), 8)
color lxColHd   = color.rgb(150, 160, 182)
color lxRowA    = color.new(color.rgb(13, 17, 28), 14)
color lxRowB    = color.new(color.rgb(22, 28, 46), 14)
color lxRowDim  = color.new(color.rgb(13, 17, 28), 52)
color lxText    = color.rgb(233, 236, 243)
color lxMuted   = color.rgb(128, 138, 158)
color lxDimTx   = color.rgb(90, 98, 116)
color lxGreen   = color.rgb(64, 216, 158)
color lxRed     = color.rgb(250, 118, 118)
color lxAmber   = color.rgb(251, 191, 36)
color lxCyan    = color.rgb(102, 208, 255)
color lxFrame   = color.new(lxGold, 42)
color lxGrid    = color.new(color.rgb(7, 10, 17), 35)
color lxBestBg  = color.new(lxGold, 84)

f_wrBar(float pct) =>
    string s = ""
    int filled = na(pct) ? 0 : math.min(10, math.max(0, math.round(pct / 10)))
    for _b = 1 to 10
        s += _b <= filled ? "▰" : "▱"
    s

f_monthShort(int m) =>
    switch m
        1  => "Jan"
        2  => "Feb"
        3  => "Mar"
        4  => "Apr"
        5  => "May"
        6  => "Jun"
        7  => "Jul"
        8  => "Aug"
        9  => "Sep"
        10 => "Oct"
        11 => "Nov"
        =>    "Dec"

var table statsTable        = table.new(f_tablePos(mainTablePosStr),     2, 12,              bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dayStatsTable     = table.new(f_tablePos(dayTablePosStr),      4, 3 + enabledDayCnt, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table monthlyStatsTable = table.new(f_tablePos(monthlyTablePosStr),  5, statMonths + 3,   bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dailyStatsTable   = table.new(f_tablePos(dailyTablePosStr),    6, 34,               bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table settingsTable     = table.new(f_tablePos(settingsTablePosStr), 2, 16,               bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

// ==========================================
// --- 9. MAIN STATS + BY-DAY TABLE ---
// ==========================================

f_drawStatsTables() =>
    var bool merged1 = false
    var bool merged2 = false
    int   winCnt  = 0
    int   lossCnt = 0
    int   streak     = 0
    int   maxW       = 0
    int   maxL       = 0
    int   curStreakStart = 0
    int   maxWStart  = 0
    int   maxWEnd    = 0
    int   maxLStart  = 0
    int   maxLEnd    = 0
    float netR       = 0.0
    float curWinSum  = 0.0
    float curLossSum = 0.0
    float maxWinR    = 0.0
    float maxLossR   = 0.0
    float curWinPips  = 0.0
    float curLossPips = 0.0
    float maxWinPips  = 0.0
    float maxLossPips = 0.0
    int[]   dowWin  = array.new_int(8, 0)
    int[]   dowLoss = array.new_int(8, 0)
    float[] dowNetR = array.new_float(8, 0.0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int tDayId = (year(t, tz) * 10000) + (month(t, tz) * 100) + dayofmonth(t, tz)
            bool valid = false
            if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
                valid := tDayId >= cutoffDraw
            else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
                valid := (year(t, tz) * 12 + month(t, tz)) >= (currentTotalM - statMonths + 1)
            else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
                valid := month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
            if valid
                float tradeR = array.get(resTradeRR, i)
                bool  isWin  = array.get(resIsWin, i)
                float tPips  = array.get(resTpPts, i)
                int   dow    = dayofweek(t, tz)
                netR += tradeR
                if streak == 0
                    curStreakStart := t
                if isWin
                    winCnt += 1
                    curWinSum  := streak >= 0 ? curWinSum + tradeR : tradeR
                    curWinPips := streak >= 0 ? curWinPips + tPips : tPips
                    if streak < 0
                        curStreakStart := t
                    streak     := streak >= 0 ? streak + 1 : 1
                    if streak > maxW
                        maxW      := streak
                        maxWStart := curStreakStart
                        maxWEnd   := t
                    maxWinR    := math.max(maxWinR, curWinSum)
                    maxWinPips := math.max(maxWinPips, curWinPips)
                    if dow >= 1 and dow <= 7
                        array.set(dowWin,  dow, array.get(dowWin,  dow) + 1)
                        array.set(dowNetR, dow, array.get(dowNetR, dow) + tradeR)
                else
                    lossCnt += 1
                    curLossSum  := streak <= 0 ? curLossSum + tradeR : tradeR
                    curLossPips := streak <= 0 ? curLossPips - tPips : -tPips
                    if streak > 0
                        curStreakStart := t
                    streak      := streak <= 0 ? streak - 1 : -1
                    if -streak > maxL
                        maxL      := -streak
                        maxLStart := curStreakStart
                        maxLEnd   := t
                    maxLossR    := math.min(maxLossR, curLossSum)
                    maxLossPips := math.min(maxLossPips, curLossPips)
                    if dow >= 1 and dow <= 7
                        array.set(dowLoss, dow, array.get(dowLoss, dow) + 1)
                        array.set(dowNetR, dow, array.get(dowNetR, dow) + tradeR)
    int   totalCnt  = winCnt + lossCnt
    float wr        = totalCnt > 0 ? (winCnt / totalCnt) * 100 : na
    color wrColor   = na(wr) ? lxMuted : wr >= 50 ? lxGreen : lxAmber
    color netRColor = totalCnt == 0 ? lxMuted : netR > 0 ? lxGreen : netR < 0 ? lxRed : lxAmber
    string netRStr  = totalCnt == 0 ? "-" : (netR > 0 ? "+" : "") + str.tostring(netR, "#.##") + "R"
    string streakStr   = streak > 0 ? "W" + str.tostring(streak) : streak < 0 ? "L" + str.tostring(-streak) : "-"
    color  streakColor = streak > 0 ? lxGreen : streak < 0 ? lxRed : lxMuted
    string periodStr = ""
    if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
        periodStr := "Last " + str.tostring(statDays) + " Days"
    else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
        periodStr := "Last " + str.tostring(statMonths) + " Months"
    else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
        periodStr := statTargetM + " " + str.tostring(actualTargetY)
    table.cell(statsTable, 0, 0,  "◆  PERFORMANCE", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(statsTable, 0, 1,  periodStr, text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(statsTable, 0, 2,  "Trades",   text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 2,  totalCnt == 0 ? "-" : str.tostring(winCnt) + "W · " + str.tostring(lossCnt) + "L", text_color=lxText, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 3,  "Winrate",  text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 3,  na(wr) ? "-" : str.tostring(wr, "#.#") + "%\n" + f_wrBar(wr), text_color=wrColor, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 4,  "Net R",    text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 4,  netRStr,    text_color=netRColor, text_size=size.normal, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 5,  "Max Streak", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 5,  "W" + str.tostring(maxW) + " · L" + str.tostring(maxL), text_color=lxAmber, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    string maxWDateStr = maxW > 0 ? str.tostring(dayofmonth(maxWStart, tz)) + " " + f_monthShort(month(maxWStart, tz)) + " – " + str.tostring(dayofmonth(maxWEnd, tz)) + " " + f_monthShort(month(maxWEnd, tz)) : "-"
    string maxLDateStr = maxL > 0 ? str.tostring(dayofmonth(maxLStart, tz)) + " " + f_monthShort(month(maxLStart, tz)) + " – " + str.tostring(dayofmonth(maxLEnd, tz)) + " " + f_monthShort(month(maxLEnd, tz)) : "-"
    table.cell(statsTable, 0, 6,  " W" + str.tostring(maxW) + " Date", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 6,  maxWDateStr, text_color=maxW > 0 ? lxGreen : lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 7,  " L" + str.tostring(maxL) + " Date", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 7,  maxLDateStr, text_color=maxL > 0 ? lxRed : lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 8,  "Max Streak R", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 8,  totalCnt == 0 ? "-" : "+" + str.tostring(maxWinR, "#.##") + "R · " + str.tostring(maxLossR, "#.##") + "R", text_color=lxAmber, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 9,  "Max Streak P", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 9,  totalCnt == 0 ? "-" : "+" + str.tostring(maxWinPips, "#.#") + "p · " + str.tostring(maxLossPips, "#.#") + "p", text_color=lxAmber, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 10, "Streak",   text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 10, streakStr,  text_color=streakColor, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 11, "Active",   text_color=lxDimTx, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 11, str.tostring(array.size(tEntry)) + " / plan " + str.tostring(array.size(pState)), text_color=lxAmber, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
    if not merged1
        merged1 := true
        table.merge_cells(statsTable, 0, 0, 1, 0)
        table.merge_cells(statsTable, 0, 1, 1, 1)
    // --- BY DAY (Sun-Sat) ---
    if showDayTable
        table.cell(dayStatsTable, 0, 0, "◆  BY DAY  ·  " + periodStr, text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
        table.cell(dayStatsTable, 0, 1, "DAY",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTable, 1, 1, "W-L",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTable, 2, 1, "WR%",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(dayStatsTable, 3, 1, "NET R", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        bool[] showDayArr = array.from(showSun, showMon, showTue, showWed, showThu, showFri, showSat)
        int   bestDow = 0
        float bestNR  = 0.0
        for bd = 0 to 6
            int bDow = bd + 1
            if array.get(showDayArr, bd) and array.get(dowWin, bDow) + array.get(dowLoss, bDow) > 0 and array.get(dowNetR, bDow) > bestNR
                bestNR  := array.get(dowNetR, bDow)
                bestDow := bDow
        int   sumW   = 0
        int   sumL   = 0
        float sumR   = 0.0
        int   rowIdx = 2
        for d = 0 to 6
            int   dow  = d + 1
            if array.get(showDayArr, d)
                int   dw     = array.get(dowWin,  dow)
                int   dl     = array.get(dowLoss, dow)
                float dnr    = array.get(dowNetR, dow)
                int   dtot   = dw + dl
                float dwr    = dtot > 0 ? (dw / dtot) * 100.0 : na
                color dwrC   = na(dwr) ? lxDimTx : dwr >= 50 ? lxGreen : lxAmber
                color dnrC   = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
                string dName = d == 0 ? "Sun" : d == 1 ? "Mon" : d == 2 ? "Tue" : d == 3 ? "Wed" : d == 4 ? "Thu" : d == 5 ? "Fri" : "Sat"
                string dwlS  = dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L"
                string dwrS  = na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%"
                string dnrS  = dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R"
                bool  isBest = dow == bestDow and dtot > 0
                color rowBg  = isBest ? lxBestBg : rowIdx % 2 == 0 ? lxRowA : lxRowB
                color dnameC = isBest ? lxTitleTx : dtot == 0 ? lxDimTx : lxText
                table.cell(dayStatsTable, 0, rowIdx, (isBest ? "★ " : "") + dName, text_color=dnameC, text_size=size.small, bgcolor=rowBg, text_halign=text.align_left)
                table.cell(dayStatsTable, 1, rowIdx, dwlS, text_color=dtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=rowBg)
                table.cell(dayStatsTable, 2, rowIdx, dwrS, text_color=dwrC, text_size=size.small, bgcolor=rowBg)
                table.cell(dayStatsTable, 3, rowIdx, dnrS, text_color=dnrC, text_size=size.small, bgcolor=rowBg, text_halign=text.align_right)
                sumW   += dw
                sumL   += dl
                sumR   += dnr
                rowIdx += 1
        int   sumTot = sumW + sumL
        float sumWR  = sumTot > 0 ? (sumW / sumTot) * 100.0 : na
        table.cell(dayStatsTable, 0, rowIdx, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
        table.cell(dayStatsTable, 1, rowIdx, sumTot == 0 ? "-" : str.tostring(sumW) + "W · " + str.tostring(sumL) + "L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
        table.cell(dayStatsTable, 2, rowIdx, na(sumWR) ? "-" : str.tostring(sumWR, "#.#") + "%", text_color=na(sumWR) ? lxDimTx : sumWR >= 50 ? lxGreen : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
        table.cell(dayStatsTable, 3, rowIdx, sumTot == 0 ? "-" : (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.##") + "R", text_color=sumTot == 0 ? lxDimTx : sumR > 0 ? lxGreen : sumR < 0 ? lxRed : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
        if not merged2
            merged2 := true
            table.merge_cells(dayStatsTable, 0, 0, 3, 0)

if showStatsTable and barstate.islast
    f_drawStatsTables()

// ==========================================
// --- 10. MONTHLY TABLE ---
// ==========================================

f_drawMonthlyTable() =>
    var bool merged4 = false
    int startTotalM = currentTotalM - statMonths + 1
    int[]   mWin    = array.new_int(statMonths, 0)
    int[]   mLoss   = array.new_int(statMonths, 0)
    float[] mNetR   = array.new_float(statMonths, 0.0)
    int[]   mMaxW   = array.new_int(statMonths, 0)
    int[]   mMaxL   = array.new_int(statMonths, 0)
    int[]   mStreak = array.new_int(statMonths, 0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int tTotalM = year(t, tz) * 12 + month(t, tz)
            int idx = tTotalM - startTotalM
            if idx >= 0 and idx < statMonths
                float tradeR = array.get(resTradeRR, i)
                bool isWin = array.get(resIsWin, i)
                int curStrk = array.get(mStreak, idx)
                if isWin
                    array.set(mWin, idx, array.get(mWin, idx) + 1)
                    curStrk := curStrk >= 0 ? curStrk + 1 : 1
                    array.set(mMaxW, idx, math.max(array.get(mMaxW, idx), curStrk))
                else
                    array.set(mLoss, idx, array.get(mLoss, idx) + 1)
                    curStrk := curStrk <= 0 ? curStrk - 1 : -1
                    array.set(mMaxL, idx, math.max(array.get(mMaxL, idx), -curStrk))
                array.set(mStreak, idx, curStrk)
                array.set(mNetR, idx, array.get(mNetR, idx) + tradeR)
    table.cell(monthlyStatsTable, 0, 0, "◆  MONTHLY  ·  Last " + str.tostring(statMonths) + " Months", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 0, 1, "MONTH",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 4, 1, "STREAK", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int bestMIdx = -1
    float bestMNR = 0.0
    for m = 0 to statMonths - 1
        if (array.get(mWin, m) + array.get(mLoss, m)) > 0 and array.get(mNetR, m) > bestMNR
            bestMNR := array.get(mNetR, m)
            bestMIdx := m
    int mSumW = 0
    int mSumL = 0
    float mSumR = 0.0
    for m = 0 to statMonths - 1
        int totalM = startTotalM + m
        int mMon = (totalM - 1) % 12 + 1
        int mYr  = math.round((totalM - mMon) / 12)
        string mLabel = f_monthShort(mMon) + " " + str.tostring(mYr)
        int mw = array.get(mWin, m)
        int ml = array.get(mLoss, m)
        float mnr = array.get(mNetR, m)
        int mtot = mw + ml
        float mwr = mtot > 0 ? (mw * 1.0 / mtot) * 100.0 : na
        color mwrC = na(mwr) ? lxDimTx : mwr >= 50 ? lxGreen : lxAmber
        color mnrC = mtot == 0 ? lxDimTx : mnr > 0 ? lxGreen : mnr < 0 ? lxRed : lxAmber
        string mwlS = mtot == 0 ? "-" : str.tostring(mw) + "W · " + str.tostring(ml) + "L"
        string mwrS = na(mwr) ? "-" : str.tostring(mwr, "#.#") + "%"
        string mnrS = mtot == 0 ? "-" : (mnr >= 0 ? "+" : "") + str.tostring(mnr, "#.##") + "R"
        bool isBestM = m == bestMIdx and mtot > 0
        color mRowBg = isBestM ? lxBestBg : m % 2 == 0 ? lxRowA : lxRowB
        color mLabelC = isBestM ? lxTitleTx : mtot == 0 ? lxDimTx : lxText
        int mmxW = array.get(mMaxW, m)
        int mmxL = array.get(mMaxL, m)
        string mStrkS = mtot == 0 ? "-" : "W" + str.tostring(mmxW) + " · L" + str.tostring(mmxL)
        table.cell(monthlyStatsTable, 0, m + 2, (isBestM ? "★ " : "") + mLabel, text_color=mLabelC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_left)
        table.cell(monthlyStatsTable, 1, m + 2, mwlS, text_color=mtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 2, m + 2, mwrS, text_color=mwrC, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 3, m + 2, mnrS, text_color=mnrC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_right)
        table.cell(monthlyStatsTable, 4, m + 2, mStrkS, text_color=mtot == 0 ? lxDimTx : lxAmber, text_size=size.small, bgcolor=mRowBg)
        mSumW += mw
        mSumL += ml
        mSumR += mnr
    int mSumTot = mSumW + mSumL
    float mSumWR = mSumTot > 0 ? (mSumW * 1.0 / mSumTot) * 100.0 : na
    color mSumWRC = na(mSumWR) ? lxDimTx : mSumWR >= 50 ? lxGreen : lxAmber
    color mSumNRC = mSumTot == 0 ? lxDimTx : mSumR > 0 ? lxGreen : mSumR < 0 ? lxRed : lxAmber
    string mSumWLS = mSumTot == 0 ? "-" : str.tostring(mSumW) + "W · " + str.tostring(mSumL) + "L"
    string mSumWRS = na(mSumWR) ? "-" : str.tostring(mSumWR, "#.#") + "%"
    string mSumNRS = mSumTot == 0 ? "-" : (mSumR >= 0 ? "+" : "") + str.tostring(mSumR, "#.##") + "R"
    int totalRow = statMonths + 2
    int allMaxW = 0
    int allMaxL = 0
    for sm = 0 to statMonths - 1
        allMaxW := math.max(allMaxW, array.get(mMaxW, sm))
        allMaxL := math.max(allMaxL, array.get(mMaxL, sm))
    string allStrkS = mSumTot == 0 ? "-" : "W" + str.tostring(allMaxW) + " · L" + str.tostring(allMaxL)
    table.cell(monthlyStatsTable, 0, totalRow, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(monthlyStatsTable, 1, totalRow, mSumWLS, text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 2, totalRow, mSumWRS, text_color=mSumWRC, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 3, totalRow, mSumNRS, text_color=mSumNRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(monthlyStatsTable, 4, totalRow, allStrkS, text_color=mSumTot == 0 ? lxDimTx : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
    if not merged4
        merged4 := true
        table.merge_cells(monthlyStatsTable, 0, 0, 4, 0)

if showMonthlyTable and barstate.islast and statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
    f_drawMonthlyTable()

// ==========================================
// --- 11. DAILY LOG TABLE (Specific Month) ---
// ==========================================

f_drawDailyTable() =>
    var bool merged3 = false
    int[]    ddWin      = array.new_int(32, 0)
    int[]    ddLoss     = array.new_int(32, 0)
    float[]  ddNetR     = array.new_float(32, 0.0)
    float[]  ddWinPips  = array.new_float(32, 0.0)
    float[]  ddLossPips = array.new_float(32, 0.0)
    string[] ddTradeStr = array.new_string(32, "")
    if array.size(resIsWin) > 0
        for k = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, k)
            if month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
                int   d       = dayofmonth(t, tz)
                bool  isWin   = array.get(resIsWin,   k)
                float tradeR  = array.get(resTradeRR, k)
                float tpPts   = array.get(resTpPts,   k)
                if d >= 1 and d <= 31
                    if isWin
                        array.set(ddWin,  d, array.get(ddWin,  d) + 1)
                        array.set(ddWinPips, d, array.get(ddWinPips, d) + tpPts)
                    else
                        array.set(ddLoss, d, array.get(ddLoss, d) + 1)
                        array.set(ddLossPips, d, array.get(ddLossPips, d) + tpPts)
                    array.set(ddNetR, d, array.get(ddNetR, d) + tradeR)
                    string rSign     = tradeR >= 0 ? "+" : ""
                    string tradeLine = "TP " + rSign + str.tostring(tradeR, "#.##") + "R\n"
                    array.set(ddTradeStr, d, array.get(ddTradeStr, d) + tradeLine)
    table.cell(dailyStatsTable, 0, 0, "◆  DAILY LOG  ·  " + statTargetM + " " + str.tostring(actualTargetY), text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 0, 1, "DATE",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 4, 1, "PIPS",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 5, 1, "TRADES", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int   totW = 0
    int   totL = 0
    float totR = 0.0
    float totWinPips  = 0.0
    float totLossPips = 0.0
    for d = 1 to 31
        int   dw   = array.get(ddWin,  d)
        int   dl   = array.get(ddLoss, d)
        float dnr  = array.get(ddNetR, d)
        float dwp  = array.get(ddWinPips,  d)
        float dlp  = array.get(ddLossPips, d)
        int   dtot = dw + dl
        float dwr  = dtot > 0 ? (dw / dtot) * 100.0 : na
        color dwrC = na(dwr) ? lxDimTx : dwr >= 50.0 ? lxGreen : lxAmber
        color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
        string dwlS   = dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L"
        string dwrS   = na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%"
        string dnrS   = dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R"
        string dpipS  = dtot == 0 ? "-" : "+" + str.tostring(dwp, "#.#") + " / -" + str.tostring(dlp, "#.#")
        color  dpipC  = dtot == 0 ? lxDimTx : (dwp - dlp) > 0 ? lxGreen : (dwp - dlp) < 0 ? lxRed : lxAmber
        string tradeS = array.get(ddTradeStr, d)
        if str.length(tradeS) > 0
            tradeS := str.substring(tradeS, 0, str.length(tradeS) - 1)
        color dayBg  = dtot == 0 ? lxRowDim : d % 2 == 1 ? lxRowA : lxRowB
        color dateC  = dtot == 0 ? lxDimTx : lxText
        table.cell(dailyStatsTable, 0, d + 1, str.tostring(d), text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 1, d + 1, dwlS,   text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 2, d + 1, dwrS,   text_color=dwrC,  text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 3, d + 1, dnrS,   text_color=dnrC,  text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 4, d + 1, dpipS,  text_color=dpipC,  text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 5, d + 1, tradeS, text_color=color.new(lxText, 22), text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_left)
        totW += dw
        totL += dl
        totR += dnr
        totWinPips  += dwp
        totLossPips += dlp
    int   totTot = totW + totL
    float totWR  = totTot > 0 ? (totW / totTot) * 100.0 : na
    color totWRC = na(totWR) ? lxDimTx : totWR >= 50 ? lxGreen : lxAmber
    color totNRC = totTot == 0 ? lxDimTx : totR > 0 ? lxGreen : totR < 0 ? lxRed : lxAmber
    string totWLS = totTot == 0 ? "-" : str.tostring(totW) + "W · " + str.tostring(totL) + "L"
    string totWRS = na(totWR) ? "-" : str.tostring(totWR, "#.#") + "%"
    string totNRS = totTot == 0 ? "-" : (totR >= 0 ? "+" : "") + str.tostring(totR, "#.##") + "R"
    string totPipS = totTot == 0 ? "-" : "+" + str.tostring(totWinPips, "#.#") + " / -" + str.tostring(totLossPips, "#.#")
    color  totPipC = totTot == 0 ? lxDimTx : (totWinPips - totLossPips) > 0 ? lxGreen : (totWinPips - totLossPips) < 0 ? lxRed : lxAmber
    table.cell(dailyStatsTable, 0, 33, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(dailyStatsTable, 1, 33, totWLS,  text_color=lxText,    text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 2, 33, totWRS,  text_color=totWRC,    text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 3, 33, totNRS,  text_color=totNRC,    text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 4, 33, totPipS, text_color=totPipC,   text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 5, 33, na(totWR) ? "" : f_wrBar(totWR), text_color=totWRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    if not merged3
        merged3 := true
        table.merge_cells(dailyStatsTable, 0, 0, 5, 0)

if showDailyTable and barstate.islast and statMode == "3. เจาะจงเดือนและปี (Specific Month)"
    f_drawDailyTable()

// ==========================================
// --- 12. SETTINGS SUMMARY TABLE ---
// ==========================================

f_drawSettingsTable() =>
    var bool merged5 = false
    table.clear(settingsTable, 0, 0, 1, 15)
    int rowIdx = 0
    table.cell(settingsTable, 0, rowIdx, "◆  SETTINGS SUMMARY", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(settingsTable, 1, rowIdx, "",                    text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    rowIdx += 1
    string sPb = pullbackMode == "% of Range" ? str.tostring(pullbackRangePct, "#.#") + "% Rng" : str.tostring(pullbackPct) + "% Prc"
    string sOneRTxt = oneRBasis == "ATR" ? ("ATR " + str.tostring(oneRAtrMult, "#.#") + "x") : (oneRBasis == "Distance" ? ("Dist " + str.tostring(oneRDistFix, "#.###")) : (str.tostring(oneRPctVal, "#.#") + "% Box"))
    string sDays = (tradeSun?"Su ":"") + (tradeMon?"Mo ":"") + (tradeTue?"Tu ":"") + (tradeWed?"We ":"") + (tradeThu?"Th ":"") + (tradeFri?"Fr ":"") + (tradeSat?"Sa":"")
    sDays := str.length(sDays) == 0 ? "None" : sDays
    color rowBg = lxRowA
    // Entry
    table.cell(settingsTable, 0, rowIdx, "─── Entry ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Mode", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "Pullback", text_color=lxCyan, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Pullback", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, sPb, text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Plan Expire", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, str.tostring(planExpireBars) + " bars", text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Trade Days", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, sDays, text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Direction", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, breakEitherWay ? "Break ⇅" : "By Pattern", text_color=breakEitherWay ? lxCyan : lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    if useMidLevel
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        string sMidPct = midDualSide ? str.tostring(math.min(midEntryPct, 50), "#") + "%⇅" : str.tostring(midEntryPct, "#") + "%"
        string sMidSl  = midSlMode == "Box Edge" ? "SLe" : "SL" + str.tostring(midSlPct, "#")
        string sMidTp  = midTpMode == "Box Edge" ? "TPe" : midTpMode == "R:R Ratio" ? "1:" + str.tostring(midRR, "#.#") : "TP" + str.tostring(midTpPct, "#")
        string sMid = sMidPct + " · " + sMidSl + " · " + sMidTp + (midOnly ? " · ONLY" : "")
        table.cell(settingsTable, 0, rowIdx, "Mid-Level", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, sMid, text_color=lxCyan, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    // Risk
    table.cell(settingsTable, 0, rowIdx, "─── Risk ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    color sOneRCol = oneRBasis == "ATR" ? color.new(color.purple, 0) : (oneRBasis == "Distance" ? lxAmber : lxText)
    table.cell(settingsTable, 0, rowIdx, "1R Basis", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, sOneRTxt, text_color=sOneRCol, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "SL Place", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, slEdgeMode ? "Box Edge" : "1R", text_color=slEdgeMode ? lxGreen : lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Risk / R:R", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "$" + str.tostring(riskAmount, "#") + " · 1:" + str.tostring(rrRatio, "#.#"), text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    if spreadPts > 0
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "Spread", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, str.tostring(spreadPts, "#.#####"), text_color=lxAmber, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    if not merged5
        merged5 := true
        table.merge_cells(settingsTable, 0, 0, 1, 0)

if showSettingsTable and barstate.islast
    f_drawSettingsTable()
